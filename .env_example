# Copy these lines into .env (git-ignored) and fill them in.
# Format is NAME=value: no quotes needed, no spaces around "=", no commas.
# Anything set here overrides the same setting in config.json; leave a line out to use config.json's value.

# OpenRouter (or any OpenAI-compatible provider)
OPENAI_API_KEY=sk-or-v1-...
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional: a model that can read images, used for job screenshots on the Add job page.
# Leave it out if OPENAI_MODEL can already read images.
VISION_MODEL=openai/gpt-4o-mini

# Gmail job alerts (email_alerts.py). The password is a 16-character Google app password
# from myaccount.google.com/apppasswords, not your normal Gmail password.
EMAIL_ALERTS_USERNAME=you@gmail.com
EMAIL_ALERTS_APP_PASSWORD=abcdefghijklmnop
